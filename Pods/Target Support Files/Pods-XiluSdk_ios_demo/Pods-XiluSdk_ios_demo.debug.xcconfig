ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/BUTTSDKFramework" "${PODS_CONFIGURATION_BUILD_DIR}/CryptoSwift" "${PODS_CONFIGURATION_BUILD_DIR}/Masonry" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit" "${PODS_ROOT}/Ads-CN/SDK" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKCore" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKLiveBase" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKLivePlayerLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKLivePullVolcLog" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKPlayerCoreLiveLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKReachability" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKStrategyLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKTTFFmpegLiveLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKVolcLog" "${PODS_ROOT}/BaiduMobAdSDK" "${PODS_ROOT}/BeiZiSDK-iOS" "${PODS_ROOT}/GDTMobSDK/GDTFramework" "${PODS_ROOT}/KSAdSDK" "${PODS_ROOT}/MSMobAdSDK/MSAdMotion" "${PODS_ROOT}/MSMobAdSDK/MSMobAdSDK" "${PODS_ROOT}/xiluAdSdk/ADXiluSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Ads-CN/BUAdLive" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Ads-CN/BUAdSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Ads-CN/CSJMediation-Only" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/Core" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/LiveBase" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/LivePlayer/Lite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/LivePull-VolcLog" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/PlayerCore/LiveLite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/Reachability" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/Strategy/Lite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/TTFFmpeg/LiveLite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/VolcLog" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BeiZiSDK-iOS/BeiZiSDK-iOS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/GDTMobSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/KSAdSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/MSMobAdSDK/MS" "${PODS_XCFRAMEWORKS_BUILD_DIR}/MSMobAdSDK/MotionLess" "${PODS_XCFRAMEWORKS_BUILD_DIR}/xiluAdSdk"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/BUTTSDKFramework/TTSDKFramework.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CryptoSwift/CryptoSwift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Masonry/Masonry.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage/SDWebImage.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit/SnapKit.framework/Headers" ${PODS_ROOT}/GDTMobSDK/GDTFramework/GDTMobSDK.xcframework/ios-arm64/GDTMobSDK.framework/Headers ${PODS_ROOT}/GDTMobSDK/GDTFramework/Tquic.xcframework/ios-arm64_armv7/Tquic.framework/Headers
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
