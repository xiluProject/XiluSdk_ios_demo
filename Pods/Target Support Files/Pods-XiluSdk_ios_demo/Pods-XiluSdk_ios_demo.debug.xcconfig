"MetricKit" -weak_framework "Network" -weak_framework "OpenAL" -weak_framework "SystemConfiguration" -weak_framework "VideoToolBox" -weak_framework "WebKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Ads-CN" "-F${PODS_CONFIGURATION_BUILD_DIR}/BUTTSDKFramework" "-F${PODS_CONFIGURATION_BUILD_DIR}/BaiduMobAdSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/BeiZiSDK-iOS" "-F${PODS_CONFIGURATION_BUILD_DIR}/CryptoSwift" "-F${PODS_CONFIGURATION_BUILD_DIR}/GDTMobSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/KSAdSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/MSMobAdSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/Masonry" "-F${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "-F${PODS_CONFIGURATION_BUILD_DIR}/SnapKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/xiluAdSdk"
